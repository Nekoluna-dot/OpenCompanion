# ============================================================
# Ombre-Brain 环境变量（gitignored）
# ============================================================

# ---- Compress / 脱水压缩 LLM（必需，hold/grow/dream 等所有调 LLM 的工具）----
# 任意 OpenAI 兼容 endpoint：DeepSeek / Gemini / Ollama / vLLM / SiliconFlow…
OMBRE_COMPRESS_API_KEY=sk-REPLACE_ME
OMBRE_COMPRESS_BASE_URL=https://api.deepseek.com/v1
OMBRE_COMPRESS_MODEL=deepseek-chat
OMBRE_COMPRESS_TIMEOUT_SECONDS=120

# ---- Embed / 向量化（可选，缺则语义检索关闭；配置后把 config.yaml 的 embedding.enabled 改为 true）----
OMBRE_EMBED_BACKEND=api
OMBRE_EMBED_API_KEY=sk-REPLACE_ME
OMBRE_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OMBRE_EMBED_MODEL=gemini-embedding-001
OMBRE_EMBED_TIMEOUT_SECONDS=120

# ---- Transport / 协议 ----
OMBRE_TRANSPORT=streamable-http

# ---- Dashboard 访问密码（可选）----
# OMBRE_DASHBOARD_PASSWORD=change-me

# ---- Hooks / HTTP 钩子鉴权（可选）----
# OMBRE_HOOK_TOKEN=change-me

# ---- AI 显示名（可选）----
# AI_NAME=Ombre
